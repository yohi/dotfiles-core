# PXE サービスを提供するネットワークインターフェース名（例: eth0, eno1, enp3s0）
# ip link show で確認できます
PXE_IFACE=eth0
# PXE ネットワークのサブネットアドレス（例: 192.168.1.0）
PXE_SUBNET=192.168.1.0
# サブネットマスク（例: 255.255.255.0）
PXE_NETMASK=255.255.255.0
# PXE を操作するホスト（操作 PC）の IP アドレス
OPERATOR_IP=192.168.1.10
# インストールする Ubuntu のバージョン（例: 24.04）
VERSION=24.04
# インストール時に作成するユーザー名
USERNAME=y_ohi
# 無人インストール完了後のマシンのホスト名（/etc/hostname に設定される）
TARGET_HOSTNAME=ubuntu-pxe
# インストール後に操作 PC から SSH 接続するための公開鍵（操作 PC 上の鍵を指定）
SSH_PUBKEY_FILE=${HOME}/.ssh/id_ed25519.pub
# GitHub ユーザー名（任意）
GITHUB_USER=
# HTTP サーバーのポート番号（デフォルト: 8080）
HTTP_PORT=8080
# ユーザーのパスワードハッシュファイルを指定するパス（任意 - 未指定時は対話プロンプトまたはパスワードなし）
PASSWORD_HASH_FILE=.password_hash
# 同じ Docker ホスト上で複数のチェックアウトを並行運用する場合、
# キャッシュ・イメージの競合を避けるため、固有のプロジェクト名を設定してください。
COMPOSE_PROJECT_NAME=
# PXE サーバーコンテナの再起動ポリシー（例: always, no）
PXE_RESTART_POLICY=no
